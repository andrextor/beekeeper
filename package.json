{
  "name": "beekeeper",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "ci:check": "pnpm lint && pnpm db:reset && pnpm test:db"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "supabase": "2.122.0"
  }
}
