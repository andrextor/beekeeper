# Names only, never values. Where each one comes from: docs/deploy.md.
# Local values are printed by `pnpm db:start`.
# Remote: Dashboard → Project Settings → API Keys (URL and publishable key are safe in an app).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Supabase CLI only (link / db push). Iván's password manager. Never in an app.
SUPABASE_DB_PASSWORD=
# scripts/reset-password.sh only. Dashboard → API Keys → secret key. Bypasses RLS: keep it in your password manager, never in an app.
SUPABASE_SECRET_KEY=
