-- Included by every test file with \ir; lives only inside the test transaction.
create schema if not exists tests;

create or replace function tests.create_user(p_email text, p_confirmed boolean default true)
returns uuid
language plpgsql
as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (id, instance_id, aud, role, email, email_confirmed_at, raw_app_meta_data, raw_user_meta_data, created_at, updated_at)
  values (
    v_id,
    '00000000-0000-0000-0000-000000000000',
    'authenticated',
    'authenticated',
    p_email,
    case when p_confirmed then now() end,
    '{"provider":"email","providers":["email"]}',
    '{}',
    now(),
    now()
  );
  return v_id;
end;
$$;

-- security definer so a test can switch from one signed-in user to another.
create or replace function tests.user_email(p_user_id uuid)
returns text
language sql
security definer
set search_path = ''
as $$
  select email from auth.users where id = p_user_id;
$$;

create or replace function tests.authenticate_as(p_user_id uuid)
returns void
language plpgsql
as $$
begin
  perform set_config(
    'request.jwt.claims',
    json_build_object('sub', p_user_id, 'role', 'authenticated', 'email', tests.user_email(p_user_id))::text,
    true
  );
  set local role authenticated;
end;
$$;

create or replace function tests.make_platform_admin(p_user_id uuid)
returns void
language sql
security definer
set search_path = ''
as $$
  update public.profiles set is_platform_admin = true where id = p_user_id;
$$;

create or replace function tests.clear_authentication()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', '', true);
  set local role postgres;
end;
$$;

grant usage on schema tests to authenticated;
grant execute on all functions in schema tests to authenticated;
